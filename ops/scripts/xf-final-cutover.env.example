# Minimal setup:
# - OLD_* identifies the current live/old XenForo host
# - NEW_* DB values are optional; the script can read them from NEW_FORUM_ROOT/src/config.php
# - If you already have BC_XF_DB_SSH_CREDENTIALS / BC_XF_DB_CREDENTIALS, the script can use those too
OLD_HOST=45.79.101.66
OLD_SSH_USER=root
OLD_SSH_PORT=22
OLD_SSH_PASSWORD='lI1\WBmZ2uRF^(P.t.266#0<L3\%e'
OLD_FORUM_ROOT=/home/nginx/domains/bareefers.org/public/forum

OLD_DB_NAME=baraforo
OLD_DB_USER=barausr
OLD_DB_PASSWORD='7R*3ITe0ad5#xtU9rn'

# Optional fallbacks the script understands:
# BC_XF_DB_SSH_CREDENTIALS=45.79.101.66,22,root,lI1\WBmZ2uRF^(P.t.266#0<L3\%e,3306
# BC_XF_DB_CREDENTIALS=baraforo,barausr,7R*3ITe0ad5#xtU9rn

NEW_FORUM_ROOT=/var/www/bareefers.org/forum
# These match the current XenForo config on the new server.
NEW_DB_HOST=localhost
NEW_DB_PORT=3306
NEW_DB_NAME=baraforo
NEW_DB_USER=barausr
NEW_DB_PASSWORD='7R*3ITe0ad5#xtU9rn'
NEW_DB_CHARSET=utf8mb4
NEW_DB_COLLATION=utf8mb4_unicode_ci

PHP_USER=www-data
XF_SYNC_ITEMS="internal_data data"
# Preserve beta-owned theme and branding files while importing old content files.
PRESERVE_FILE_ITEMS="data/assets data/local data/styles styles sponsor_banners"
PRESERVE_STYLES=1
RSYNC_DELETE=1
BACKUP_NEW_FILES=0
DRY_RUN=0
FORCE=0
WORK_ROOT_BASE=/var/tmp/xf-final-cutover

# Set to 1 if the old host needs sudo to read XenForo files during rsync.
OLD_RSYNC_SUDO=0
OLD_USE_ROOT_MYSQL=1

# Optional: preserve specific beta DB tables instead of taking old XenForo settings/themes.
# Defaults preserve styles, templates, phrases, widgets, options, and xf_payment_profile (PayPal / payment setup on new server).

# Optional: run a command on the old host before dump/sync to freeze writes.
# Example only; replace with your real maintenance-mode command if you have one.
OLD_MAINTENANCE_CMD=

# Optional: run a command on the old host after the new server is updated.
OLD_POST_CUTOVER_CMD=

# Post-cutover ACP hygiene (see xf-final-cutover.sh): FileCleanUp permissions + upgrade-check noise
POST_CUTOVER_ACP_FIXES=1
# chown entire NEW_FORUM_ROOT so XF 2.3 FileCleanUp can delete legacy files outside internal_data (default 1).
POST_CUTOVER_CHOWN_FORUM_ROOT=1
# sudo -u PHP_USER php cmd.php xf:file-clean-up XF -n after chown (default 1). Set 0 to rely on job queue only.
POST_CUTOVER_XF_FILE_CLEANUP_CLI=1
POST_CUTOVER_PATCH_ONE_CLICK_UPGRADE=1
POST_CUTOVER_DELETE_UPGRADE_CHECK_JOBS=1
# Strip ACP noise: rows logged while cron/web hit XF during DB swap (1146 xf_job / xf_user). Set 0 to keep.
CLEAR_TRANSIENT_ERROR_LOG_AFTER_IMPORT=1

# Optional: run BAR style16 primary snapshot at start of xf-final-cutover (before DB import).
# Copy xf-backup-bar-style16-visual.sh + xf-backup-style16-visual.php + xf-export-template-to-less-file.php to /tmp first.
# RUN_BAR_STYLE16_PRIMARY_SNAPSHOT=1
# BAR_STYLE16_PRIMARY_BACKUP_SCRIPT=/tmp/xf-backup-bar-style16-visual.sh

# --- xf-pre-cutover-backup.sh (emergency rollback; not used by xf-final-cutover.sh) ---
# ROLLBACK_ARCHIVE_DIR=/home/xf-emergency-rollback
# COPY_TARBALL_TO_ROLLBACK_DIR=1
# INCLUDE_SYSTEM_ROLLBACK=1
# NGINX_ETC=/etc/nginx
# TLS_EXTRA_PATHS="/etc/letsencrypt"
# BACKUP_ACME_SH=1
# ACME_SH_HOME=/root/.acme.sh
# BACKUP_PHP_ETC=1
