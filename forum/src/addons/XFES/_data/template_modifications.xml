<?xml version="1.0" encoding="utf-8"?>
<template_modifications>
  <modification type="admin" template="forum_edit" modification_key="xfes_forum_edit_similar_threads_exclude" description="Adds a similar threads exclusion toggle to the forum edit page" execution_order="10" enabled="1" action="preg_replace">
    <find><![CDATA[#(<xf:checkboxrow rowid="advancedToggles">.+)(<\/xf:checkboxrow>)#isU]]></find>
    <replace><![CDATA[$1
	<xf:option name="similar_threads_include" selected="!in_array($forum.node_id, $xf.options.xfesSimilarThreadsExcludedForums)"
		label="{{ phrase('xfes_display_similar_threads_suggestions_in_this_forum') }}"
		hint="{{ phrase('xfes_if_disabled_similar_thread_suggestions_will_not_be_displayed_in_forum') }}" />
$2]]></replace>
  </modification>
  <modification type="public" template="forum_post_thread" modification_key="xfes_forum_post_thread_container" description="Adds the suggested thread search container beneath the title field" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<!--[XF:title_final_html]-->]]></find>
    <replace><![CDATA[$0

<xf:if is="$forum.isSimilarThreadSuggestionsEnabled()">
	<xf:include template="xfes_suggested_threads_container" />
</xf:if>]]></replace>
  </modification>
  <modification type="public" template="forum_post_thread" modification_key="xfes_forum_post_thread_handler" description="Adds the suggested thread handler to the thread title field" execution_order="10" enabled="1" action="preg_replace">
    <find><![CDATA[/(<xf:prefixinputrow.+)(\/>)/isU]]></find>
    <replace><![CDATA[$1 
data-xf-init="{{ $forum.isSimilarThreadSuggestionsEnabled() ? 'suggested-threads' : '' }}" 
data-search-url="{{ link('forums/find-suggested-threads', $forum) }}" $2]]></replace>
  </modification>
  <modification type="public" template="thread_list_macros" modification_key="xfes_thread_list_macros_container" description="Adds the suggested thread search container beneath the quick thread title field" execution_order="10" enabled="1" action="str_replace">
    <find><![CDATA[<!--[XF:qt_title_after]-->]]></find>
    <replace><![CDATA[$0 

<xf:if is="$forum.isSimilarThreadSuggestionsEnabled()">
	<xf:include template="xfes_suggested_threads_container" />
</xf:if>]]></replace>
  </modification>
  <modification type="public" template="thread_list_macros" modification_key="xfes_thread_list_macros_handler" description="Adds the suggested thread handler to the quick thread system" execution_order="10" enabled="1" action="preg_replace">
    <find><![CDATA[/(<xf:macro id="quick_thread".+<xf:prefixinput .+)(\/>)/isU]]></find>
    <replace><![CDATA[$1 
data-xf-init="{{ $forum.isSimilarThreadSuggestionsEnabled() ? 'suggested-threads' : '' }}" 
data-search-url="{{ link('forums/find-suggested-threads', $forum) }}" $2]]></replace>
  </modification>
</template_modifications>
