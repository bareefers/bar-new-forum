  <template type="public" title="xfes_forum_find_suggested_threads" version_id="2030010" version_string="2.3.0 Alpha"><![CDATA[<xf:css src="xfes_suggested_threads.less" />

<xf:head option="robots"><meta name="robots" content="noindex" /></xf:head>

<xf:if is="$suggestedThreads is not empty">
	<div class="suggestedThreads">
		<h4 class="suggestedThreads-header">
			<a class="suggestedThreads-headerCloser js-suggestedThreadDisable"
				role="button" tabindex="0"
				title="{{ phrase('close')|for_attr }}"
				aria-label="{{ phrase('close')|for_attr }}"></a>

			<xf:if is="$forum.forum_type_id == 'article'">
				{{ phrase('xfes_suggest_heading_article') }}
			<xf:elseif is="$forum.forum_type_id == 'question'" />
				{{ phrase('xfes_suggest_heading_question') }}
			<xf:elseif is="$forum.forum_type_id == 'suggestion'" />
				{{ phrase('xfes_suggest_heading_suggestion') }}
			<xf:else />
				{{ phrase('xfes_suggest_heading_discussion') }}
			</xf:if>
		</h4>
		<ol class="suggestedThreads-threads">
			<xf:foreach loop="$suggestedThreads" value="$suggestedThread">
				<li>
					<xf:macro id="suggested_thread" arg-thread="{$suggestedThread}" />
				</li>
			</xf:foreach>
		</ol>
	</div>
</xf:if>

<xf:macro id="suggested_thread" arg-thread="!">
	<div class="contentRow">
		<div class="contentRow-figure">
			<xf:avatar user="{$thread.User}" href="" size="xxs" defaultname="{$thread.username}" />
		</div>

		<div class="contentRow-main contentRow-main--close">
			<a href="{{ link('threads', $thread) }}">{{ prefix('thread', $thread) }}{$thread.title}</a>

			<div class="contentRow-minor contentRow-minor--smaller">
				{{ snippet($thread.FirstPost.message, 100, {'stripQuote': true}) }}
			</div>
		</div>
	</div>
</xf:macro>]]></template>
  <template type="public" title="xfes_suggested_threads.less" version_id="2020035" version_string="2.2.0 Beta 5"><![CDATA[.suggestedThreads
{
	margin-top: @xf-paddingLarge;
	.xf-blockBorder();
	border-radius: @xf-blockBorderRadius;
}

.suggestedThreads-header
{
	padding: @xf-blockPaddingV @xf-paddingLarge;
	margin: 0;
	font-size: @xf-fontSizeLarge;
	font-weight: @xf-fontWeightNormal;
	color: @xf-majorHeadingTextColor;
	text-decoration: none;
	background: @xf-majorHeadingBg;
	border-bottom: @xf-borderSize solid @xf-borderColorLight;

	.m-clearFix();
	.m-hiddenLinks();
}

.suggestedThreads-headerCloser
{
	float: right;
	cursor: pointer;
	margin-left: 5px;
	text-decoration: none;
	opacity: .75;
	.m-transition();

	&:after
	{
		.m-faBase();
		.m-faContent(@fa-var-times, .625em);
	}

	&:hover
	{
		text-decoration: none;
		opacity: 1;
	}
}

.suggestedThreads-threads
{
	.m-listPlain();

	> li
	{
		padding: @xf-paddingLarge;
	}
}]]></template>
