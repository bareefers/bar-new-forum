		<xf:explain>{{ phrase('xfes_word_stemming_explain') }}</xf:explain>
	</xf:radiorow>

	<xf:checkboxrow>
		<xf:option name="index[ascii_folding]" selected="{$analyzerConfig.ascii_folding}" label="{{ phrase('xfes_enable_accent_removal_and_character_simplification') }}">
			<xf:hint>{{ phrase('xfes_remove_accents_simplify_explain') }}</xf:hint>
		</xf:option>
	</xf:checkboxrow>
</xf:macro>]]></template>
  <template type="admin" title="xfes_mlt_analyzer" version_id="2020035" version_string="2.2.0 Beta 5"><![CDATA[<xf:title>MLT query analyzer</xf:title>

<div class="block">
	<div class="block-container">
		<h2 class="block-tabHeader tabs" data-xf-init="tabs">
			<a class="tabs-tab {{ $type == 'thread_creation' ? 'is-active' : '' }}" role="tab" tabindex="0">Thread creation</a>
			<a class="tabs-tab {{ $type == 'similar_threads' ? 'is-active' : '' }}" role="tab" tabindex="0">Similar threads</a>
			<a class="tabs-tab {{ $type == 'raw_query' ? 'is-active' : '' }}" role="tab" tabindex="0">Raw query</a>
		</h2>

		<ul class="tabPanes">
			<li class="{{ $type == 'thread_creation' ? 'is-active' : '' }}">
				<xf:form action="{{ link('enhanced-search/mlt-analyzer') }}">
					<div class="block-body">
						<xf:textboxrow label="Title" name="title" value="{$creationTitle}" required="required" />
						<xf:selectrow label="Forum" name="node_id" value="{$creationNodeId}" required="required">
							<xf:option></xf:option>

							<xf:foreach loop="$nodeTree.getFlattened(0)" value="$treeEntry">
								<xf:option value="{$treeEntry.record.node_id}"
									disabled="{{ $treeEntry.record.node_type_id != 'Forum' }}"
									label="{{ repeat('&nbsp;&nbsp;', $treeEntry.depth)|raw }} {$treeEntry.record.title}" />
							</xf:foreach>
						</xf:selectrow>
					</div>
					<xf:submitrow submit="Get results" />
					<xf:hiddenval name="type">thread_creation</xf:hiddenval>
				</xf:form>
			</li>
			<li class="{{ $type == 'similar_threads' ? 'is-active' : '' }}">
				<xf:form action="{{ link('enhanced-search/mlt-analyzer') }}">
					<div class="block-body">
						<xf:textboxrow label="Thread URL" name="thread_url" value="{$threadUrl}" type="url" required="required" />
					</div>
					<xf:submitrow submit="Get results" />
					<xf:hiddenval name="type">similar_threads</xf:hiddenval>
				</xf:form>
			</li>
			<li class="{{ $type == 'raw_query' ? 'is-active' : '' }}">
				<xf:form action="{{ link('enhanced-search/mlt-analyzer') }}">
					<div class="block-body">
						<xf:textarearow label="Query JSON" name="query"
							value="{{ $query ?: ($dsl ? $dsl|json(true) : '') }}" rows="10" code="true" required="required" />
					</div>
					<xf:submitrow submit="Get results" />
					<xf:hiddenval name="type">raw_query</xf:hiddenval>
				</xf:form>
			</li>
		</ul>
	</div>
</div>

<xf:if is="$dsl">
	<div class="block">
		<div class="block-container">
			<h2 class="block-header">Results: {$inputThread.title}</h2>
			<div class="block-body">
				<xf:datalist>
					<xf:datarow rowtype="header">
						<xf:cell>{{ phrase('title') }}</xf:cell>
						<xf:cell class="dataList-cell--min">Score</xf:cell>
						<xf:cell class="dataList-cell--min">{{ phrase('forum') }}</xf:cell>
						<xf:cell class="dataList-cell--min">{{ phrase('thread_starter') }}</xf:cell>
						<xf:cell class="dataList-cell--min">{{ phrase('last_message') }}</xf:cell>
					</xf:datarow>
					<xf:foreach loop="$threadScores" key="$threadId" value="$score">
						<xf:set var="$thread" value="{$threads.{$threadId}}" />
						<xf:datarow>
							<xf:cell>
								<a href="{{ link_type('public', 'threads', $thread) }}">{$thread.title}</a>
							</xf:cell>
							<xf:cell class="dataList-cell--min">
								{$score}
							</xf:cell>
							<xf:cell class="dataList-cell--min">
								{$thread.Forum.title}
							</xf:cell>
							<xf:cell class="dataList-cell--min">
								{$thread.username}
							</xf:cell>
							<xf:cell class="dataList-cell--min">
								<xf:date time="{$thread.last_post_date}" />
							</xf:cell>
						</xf:datarow>
					</xf:foreach>
				</xf:datalist>
			</div>
		</div>
	</div>

	<div class="block">
		<div class="block-container">
			<h2 class="block-header">DSL</h2>
			<div class="block-body block-row block-body--contained">
				<pre>{{ $dsl|json(true) }}</pre>
			</div>
		</div>
	</div>
</xf:if>]]></template>
