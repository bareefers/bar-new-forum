<phrases>
  <phrase title="admin_navigation.barFail2ban" version_id="1000015" version_string="1.0.5"><![CDATA[Fail2ban IP unban]]></phrase>
  <phrase title="bar_f2b_title" version_id="1000015" version_string="1.0.5"><![CDATA[Unblock a locked-out member (fail2ban)]]></phrase>
  <phrase title="bar_f2b_explain" version_id="1000015" version_string="1.0.5"><![CDATA[Use this when someone cannot open the forum because our automatic anti-bot shield blocked their network address. This does <b>not</b> remove a normal XenForo user ban.]]></phrase>
  <phrase title="bar_f2b_steps_title" version_id="1000015" version_string="1.0.5"><![CDATA[Steps]]></phrase>
  <phrase title="bar_f2b_steps_body" version_id="1000015" version_string="1.0.5"><![CDATA[<ol>
<li>Ask the person to open <a href="https://www.whatismyip.com/" target="_blank" rel="noopener">whatismyip.com</a> on the <b>same device and network</b> that cannot reach the forum, and send you the <b>IPv4</b> address (example: 69.153.247.253).</li>
<li>Paste that IP below and click <b>Look up</b>.</li>
<li>If status shows <b>Banned</b>, click <b>Unban IP</b>.</li>
<li>Wait for the green <b>Success</b> message, then ask them to try the forum again.</li>
</ol>]]></phrase>
  <phrase title="bar_f2b_need_ip_note" version_id="1000015" version_string="1.0.5"><![CDATA[Important: always use the IP address they send you from whatismyip.com. Looking up their username only shows older addresses and may not be the one that is blocked.]]></phrase>
  <phrase title="bar_f2b_query" version_id="1000015" version_string="1.0.5"><![CDATA[Username or IP]]></phrase>
  <phrase title="bar_f2b_query_explain" version_id="1000015" version_string="1.0.5"><![CDATA[Prefer pasting the IP they gave you. Username lookup is optional and only shows recent IPs XenForo already knows.]]></phrase>
  <phrase title="bar_f2b_lookup" version_id="1000015" version_string="1.0.5"><![CDATA[Look up]]></phrase>
  <phrase title="bar_f2b_enter_username_or_ip" version_id="1000015" version_string="1.0.5"><![CDATA[Enter a username or IP address.]]></phrase>
  <phrase title="bar_f2b_no_recent_ips" version_id="1000015" version_string="1.0.5"><![CDATA[No recent IP addresses were found for that member. Ask them for their current IP from whatismyip.com instead.]]></phrase>
