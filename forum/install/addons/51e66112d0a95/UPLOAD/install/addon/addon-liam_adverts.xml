  <route_prefixes>
    <route_type type="admin">
      <prefix original_prefix="adverts" class="LiamAds_Route_PrefixAdmin_Adverts" build_link="data_only"/>
    </route_type>
  </route_prefixes>
  <style_properties/>
  <templates/>
  <public_template_modifications/>
  <bb_code_media_sites/>
</addon>
