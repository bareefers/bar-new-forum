<?xml version="1.0" encoding="utf-8"?>
<addon addon_id="InactiveMembers" title="Inactive Members" version_string="3.1" version_id="1" url="" install_callback_class="" install_callback_method="" uninstall_callback_class="" uninstall_callback_method="">
  <admin_navigation/>
  <admin_permissions/>
  <admin_style_properties/>
  <admin_templates/>
  <admin_template_modifications/>
  <code_events/>
  <code_event_listeners/>
  <cron>
    <entry entry_id="InactiveMembers" cron_class="Andy_InactiveMembers_CronEntry_InactiveMembers" cron_method="runInactiveMembers" active="1"><![CDATA[{"day_type":"dom","dom":["1"],"hours":["8"],"minutes":["0"]}]]></entry>
  </cron>
  <email_templates>
    <template title="inactivemembers_contact">
      <subject><![CDATA[{xen:phrase contact_email_subject, 'subject={$subject}', 'board_title={$xenOptions.boardTitle}'}]]></subject>
      <body_text><![CDATA[{xen:phrase contact_email_body_text,
	'name={$user.username}',
	'user_id={$user.user_id}',
	'email={$user.email}',
	'subject={$subject}',
	'message={$message}',
	'board_title={$xenOptions.boardTitle}'
}]]></body_text>
      <body_html><![CDATA[<h2 style="font-size: 18pt; font-weight: normal; margin: 10px 0">{$subject}</h2>

<hr style="height: 1px; margin: 10px 0; border: 0; color: #D7EDFC; background-color: #D7EDFC" />

<table cellpadding="0" cellspacing="0" border="0">
<tr valign="top">
<xen:if is="{$user.user_id}">
<td style="font-size: 13px; line-height: 1.231; padding-{xen:if $emailIsRtl, left, right}: 20px">
	<a href="{xen:link canonical:members, $user}" title="{$user.username}" style="color: #176093; text-decoration: none; font-size: 9px; display: block; background-color: #D7EDFC; border: 1px solid #D7EDFC; border-radius: 5px">
		<span style="display: block; background-color: #F0F7FC; padding: 5px; border-radius: 4px">
			<img src="{xen:helper avatar, $user, s, '', 1}" alt="{$user.username}" title="{$user.username}" style="display: block; width: 48px; height: 48px; background-color: #FCFCFF; border: 1px solid #A5CAE4; padding: 2px; border-radius: 4px" />
		</span>
		<span style="padding: 3px 5px; display: block"><!--{$user.username}-->&nbsp;</span>
	</a>
</td>
</xen:if>
<td style="font-family: Georgia, 'Times New Roman', Times, serif; font-size: 11pt; line-height: 1.4">
	{xen:raw $message}
</td>	
</tr>
</table>

<hr style="height: 1px; margin: 10px 0; border: 0; color: #D7EDFC; background-color: #D7EDFC" />]]></body_html>
    </template>
  </email_templates>
